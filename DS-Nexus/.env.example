# ==========================================
# ABES CSE(DS) NEXUS - ENVIRONMENT CONFIG
# ==========================================
PORT=3002

# ------------------------------------------
# REAL EMAIL DISPATCH VIA GMAIL SMTP
# ------------------------------------------
# To receive OTPs directly into your real Gmail / College inbox:
# 1. Go to your Google Account -> Security -> 2-Step Verification -> App Passwords
#    (Direct Link: https://myaccount.google.com/apppasswords)
# 2. Generate a 16-character App Password for 'Mail' / 'Nexus'
# 3. Enter your Gmail address and 16-character password below (without spaces):

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional sender display address. Defaults to GMAIL_USER when omitted.
SMTP_FROM=

# Set to true for Gmail port 465; use false with SMTP_PORT=587 (STARTTLS).
SMTP_SECURE=true

# Set to 1 only when deployed behind a trusted reverse proxy (Render, Nginx, etc.).
TRUST_PROXY=0

# ------------------------------------------
# OPTIONAL: CUSTOM SMTP / MICROSOFT 365
# ------------------------------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=datascience@abes.ac.in
# SMTP_PASS=your_smtp_password

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3002
