# ==========================================
# ABES CSE(DS) NEXUS - ENVIRONMENT CONFIG
# ==========================================
PORT=3004

# ------------------------------------------
# REAL EMAIL DISPATCH VIA GMAIL SMTP
# ------------------------------------------
# To receive OTPs directly into your Gmail / College inbox:
# 1. Go to your Google Account -> Security -> 2-Step Verification -> App Passwords
#    (Direct Link: https://myaccount.google.com/apppasswords)
# 2. Generate a 16-character App Password for 'Mail' / 'Nexus'
# 3. Enter your Gmail address and 16-character password below (without spaces):

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional display address. It must be authorized by the SMTP account.
SMTP_FROM=

# ------------------------------------------
# OPTIONAL: CUSTOM SMTP / MICROSOFT 365
# ------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=datascience@abes.ac.in
# SMTP_PASS=your_smtp_password

# Set to true only when deployed behind a trusted HTTPS reverse proxy.
TRUST_PROXY=false

ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3004
